# Copy to calltrigger-api/.env and fill in. Never commit .env.

# The React dev server sends this as X-API-Key.
# Leave it empty: the API generates a strong key on first start and saves it to .env.
# Copy that value into frontend/.env as TRIGGER_API_KEY.
TRIGGER_API_KEY=

# Optional SQLite file for the queue (default: calltrigger-api/collections.sqlite3).
# COLLECTIONS_DB=

# Leave both empty for demos so the API cannot place real calls.
CALL_API_URL=
CALL_API_TOKEN=

# Sarvam: only for notebook photo scanning and call-note review.
SARVAM_API_KEY=

# Cashfree TEST mode credentials: payment refresh and webhook signature checks.
CASHFREE_PG_CLIENT_ID=
CASHFREE_PG_CLIENT_SECRET=
